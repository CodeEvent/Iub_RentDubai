<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RentShield Identity Verification"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- 1. Login -->
    <LinearLayout
        android:id="@+id/section_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/input_server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="RentShield server, e.g. http://192.168.0.120:8000"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/input_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/button_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in" />
    </LinearLayout>

    <!-- 2. Biometric gate -->
    <LinearLayout
        android:id="@+id/section_biometric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm it's you with Face ID/fingerprint before continuing."
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/button_biometric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue" />
    </LinearLayout>

    <!-- 3. Document entry -->
    <LinearLayout
        android:id="@+id/section_document"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/radio_document_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radio_passport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passport"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radio_cie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Italian Digital ID (CIE)"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/fields_passport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/input_passport_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Passport number"
                android:inputType="textCapCharacters|textNoSuggestions" />

            <EditText
                android:id="@+id/input_date_of_birth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Date of birth (YYMMDD)"
                android:inputType="number" />

            <EditText
                android:id="@+id/input_expiration_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Passport expiry date (YYMMDD)"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fields_cie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/input_can"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="CAN -- the 6-digit number only (NOT the card's longer ID/serial number)"
                android:inputType="number" />
        </LinearLayout>

        <Button
            android:id="@+id/button_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ready to scan -- hold document to phone" />
    </LinearLayout>

    <!-- 4/5/6. Status, selfie, upload, result -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="" />

    <ImageView
        android:id="@+id/photo_preview"
        android:layout_width="160dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:contentDescription="Extracted chip photo" />

    <Button
        android:id="@+id/button_selfie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Take selfie"
        android:visibility="gone" />

    <Button
        android:id="@+id/button_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Done"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>
