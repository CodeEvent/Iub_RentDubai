<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RentShield Identity Verification"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- 1. Login: QR scan only. There is deliberately no manual
         server/username/password fallback here: those fields typed on
         a phone keyboard were the direct cause of this project's most
         repeated real bug (a mistyped CAN, or the card's printed serial
         number typed into the CAN field). Declaring the document and
         signing in both now happen on the web, on a real keyboard;
         see identity-verification.component.ts's "declare your
         document" step and documents/rentshield_identity/
         pairing_views.py. -->
    <LinearLayout
        android:id="@+id/section_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Start on RentShield's website first: fill in your document details there, then scan the QR code it shows you." />

        <Button
            android:id="@+id/button_scan_pairing_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan QR to sign in" />
    </LinearLayout>

    <!-- 2. Biometric gate -->
    <LinearLayout
        android:id="@+id/section_biometric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm it's you with Face ID/fingerprint before continuing."
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/button_biometric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue" />
    </LinearLayout>

    <!-- 3. Document entry -->
    <LinearLayout
        android:id="@+id/section_document"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/radio_document_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radio_passport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passport"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radio_cie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Italian Digital ID (CIE)"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/fields_passport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/input_passport_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Passport number"
                android:inputType="textCapCharacters|textNoSuggestions" />

            <EditText
                android:id="@+id/input_date_of_birth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Date of birth (YYMMDD)"
                android:inputType="number" />

            <EditText
                android:id="@+id/input_expiration_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Passport expiry date (YYMMDD)"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fields_cie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/input_can"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="CAN -- the 6-digit number only (NOT the card's longer ID/serial number)"
                android:inputType="number" />
        </LinearLayout>

        <Button
            android:id="@+id/button_card_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. Take a photo of your ID card" />

        <Button
            android:id="@+id/button_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2. Ready to scan -- hold document to phone"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Status, per-step capture buttons, result -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="" />

    <ImageView
        android:id="@+id/photo_preview"
        android:layout_width="160dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:contentDescription="Card photo or selfie preview" />

    <Button
        android:id="@+id/button_selfie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="3. Take selfie"
        android:visibility="gone" />

    <Button
        android:id="@+id/button_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="4. Record a short confirmation video (2 sentences)"
        android:visibility="gone" />

    <!-- In-app video recording, replacing the plain camera intent used
         for the card photo/selfie: the required sentence has to be
         shown ON SCREEN while recording, which only a live in-app
         preview (CameraX) can do; the system camera app's own UI
         can't be made to display it. -->
    <FrameLayout
        android:id="@+id/section_video_record"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/video_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/video_prompt_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#AA000000"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:text="" />
    </FrameLayout>

    <Button
        android:id="@+id/button_record_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Start Recording"
        android:visibility="gone" />

    <Button
        android:id="@+id/button_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Done"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>
